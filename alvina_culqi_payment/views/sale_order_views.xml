<odoo>
    <record id="sale_order_form_culqilink" model="ir.ui.view">
        <field name="name">sale.order.form.culqilink</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_generate_culqi_link" type="object" string="Generar enlace Culqi"
                        groups="sales_team.group_sale_salesman" invisible="state != 'sale'"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Culqi" groups="sales_team.group_sale_salesman">
                    <div class="alert alert-warning" role="status">Conector en desarrollo. No habilitado para cobros reales.</div>
                    <group>
                        <field name="culqi_request_state"/>
                        <field name="culqi_request_id"/>
                        <field name="culqi_transaction_id" groups="base.group_system"/>
                        <field name="culqi_link_url" widget="CopyClipboardURL"/>
                        <button name="action_open_culqi_link" type="object" string="Abrir enlace Culqi"
                                invisible="culqi_request_state != 'created'"/>
                        <button name="action_send_culqi_link" type="object" string="Enviar enlace por correo"
                                invisible="culqi_request_state != 'created'"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
