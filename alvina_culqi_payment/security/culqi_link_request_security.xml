<odoo>
    <record id="culqi_request_company_rule" model="ir.rule">
        <field name="name">Culqi requests in allowed companies</field>
        <field name="model_id" ref="model_alvina_culqi_link_request"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="culqi_request_sales_own_rule" model="ir.rule">
        <field name="name">Culqi requests for own or unassigned orders</field>
        <field name="model_id" ref="model_alvina_culqi_link_request"/>
        <field name="domain_force">['|', ('sale_order_id.user_id', '=', user.id), ('sale_order_id.user_id', '=', False)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>
    <record id="culqi_request_sales_all_rule" model="ir.rule">
        <field name="name">Culqi requests for all orders</field>
        <field name="model_id" ref="model_alvina_culqi_link_request"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('sales_team.group_sale_salesman_all_leads')), (4, ref('base.group_system'))]"/>
    </record>
</odoo>
